/// A production machine (equipment) on a line, with live telemetry streamed from the plant gateway every 10 seconds.
entity Machine
	lineageTag: a2ac3e95-24ce-4221-be52-a8c0a7dd3391
	backingTable: dim_machine
	keyProperty: MachineId
	synonym equipment
	synonym asset
	synonym mesin

	/// Unique machine identifier.
	property MachineId
		dataType: string
		lineageTag: bf0a5133-03a6-48b2-a144-02d6a085e82d

		backingConfiguration
			valueColumn: dim_machine.MachineId

	/// Machine display name.
	property MachineName
		dataType: string
		lineageTag: 04f91868-3a94-4b18-b3ab-03d8d372e6c2

		backingConfiguration
			valueColumn: dim_machine.MachineName

	/// InjectionMolder, AirCompressor, Chiller, RobotArm, Conveyor, CNCMill or Packer.
	property MachineType
