/// A maintenance work order raised against a machine.
entity WorkOrder
	lineageTag: e81a4b51-3b65-46d5-b032-906557d49b2f
	backingTable: maintenance_work_order
	keyProperty: WorkOrderId
	synonym maintenance
	synonym workorder

	/// Unique work order identifier.
	property WorkOrderId
		dataType: string
		lineageTag: dec7ee3a-da0a-41c9-a656-6f0d07e9da77

		backingConfiguration
			valueColumn: maintenance_work_order.WorkOrderId

