  "queries": [
    {
      "id": "71a6f6ce-9118-5770-939f-3c125daf268c",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b6918b0a-cc75-5f2d-855c-b40ebb261542"
      },
      "usedVariables": [],
      "text": "DimSite\n| order by SiteName asc\n| project SiteId, SiteName\n"
    },
    {
      "id": "af505af1-4fd8-53fc-93f3-87a4000ce94c",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b6918b0a-cc75-5f2d-855c-b40ebb261542"
      },
      "usedVariables": [],
      "text": "DimMachine\n| order by SiteId asc, LineId asc, MachineId asc\n| project MachineId, MachineName = strcat(MachineId, \" - \", MachineName)\n"
    },
    {
      "id": "c3e0c907-a13b-5115-aa6b-7174d95a146b",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b6918b0a-cc75-5f2d-855c-b40ebb261542"
      },
      "usedVariables": [
        "_sites"
      ],
      "text": "SiteStatus()\n| where SiteId in (_sites) or isempty(_sites)\n| project SiteName, City, Latitude, Longitude, Machines, Critical, Warning, Healthy, Offline, SiteHealth\n| order by SiteName asc\n"
    },
    {
      "id": "eff5d71e-93e9-5584-a107-eec1ba7a75d2",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b6918b0a-cc75-5f2d-855c-b40ebb261542"
      },
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_sites"
      ],
      "text": "let current = materialize(MachineCurrentState() | where SiteId in (_sites) or isempty(_sites));\nlet counts = current\n    | summarize Critical=countif(HealthState == \"Critical\"),\n                Warning=countif(HealthState == \"Warning\"),\n                Healthy=countif(HealthState == \"Healthy\");\nlet units = toscalar(\n    MachineTelemetry\n    | where Timestamp between (_startTime .. _endTime)\n    | where SiteId in (_sites) or isempty(_sites)\n    | summarize UnitsProduced=sum(UnitsProduced)\n);\ncounts\n| project Metric=\"Critical machines\", Value=Critical\n| union (counts | project Metric=\"Warning machines\", Value=Warning)\n| union (counts | project Metric=\"Healthy machines\", Value=Healthy)\n| union (print Metric=\"Units produced\", Value=tolong(coalesce(units, 0)))\n"
    },
    {
      "id": "183a99af-6e3b-5fa1-8565-fe48fc188b2c",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b6918b0a-cc75-5f2d-855c-b40ebb261542"
      },
      "usedVariables": [
        "_sites"
      ],
